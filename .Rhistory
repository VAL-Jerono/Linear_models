reg_metrics <- function(model_obj, X_mat = NULL, newdata = NULL,
y_true, model_name, is_glmnet = FALSE,
lambda_val = NULL) {
preds <- if (is_glmnet)
as.vector(predict(model_obj, newx = X_mat, s = lambda_val))
else
predict(model_obj, newdata = newdata)
resids <- y_true - preds
mape   <- mean(abs(resids / (y_true + 1e-8))) * 100
data.frame(
Model = model_name,
RMSE  = round(sqrt(mean(resids^2)), 4),
MAE   = round(mean(abs(resids)),     4),
R2    = round(1 - sum(resids^2) / sum((y_true - mean(y_true))^2), 4),
MAPE  = round(mape, 2)
)
}
reg_comparison <- bind_rows(
reg_metrics(ols_full, newdata=test_df, y_true=y_test, model_name="OLS Full"),
reg_metrics(ols_step, newdata=test_df, y_true=y_test, model_name="OLS Stepwise"),
reg_metrics(cv_ridge, X_mat=X_test, y_true=y_test, is_glmnet=TRUE,
lambda_val=cv_ridge$lambda.min, model_name="Ridge (λ.min)"),
reg_metrics(cv_lasso, X_mat=X_test, y_true=y_test, is_glmnet=TRUE,
lambda_val=cv_lasso$lambda.min, model_name="Lasso (λ.min)"),
reg_metrics(cv_enet,  X_mat=X_test, y_true=y_test, is_glmnet=TRUE,
lambda_val=cv_enet$lambda.min,
model_name=paste0("Elastic Net (α=", best_alpha, ")"))
)
cat("\n===== REGRESSION MODEL COMPARISON (Test Set) =====\n")
reg_comparison %>% arrange(RMSE) %>%
kable(caption = "Regression Models Ranked by Test RMSE") %>%
kable_styling(bootstrap_options = c("striped","hover","condensed"))
# Best model predictions plot
best_reg_name <- reg_comparison$Model[which.min(reg_comparison$RMSE)]
cat("\nBest model:", best_reg_name, "\n")
best_preds <- if (grepl("Ridge", best_reg_name)) {
as.vector(predict(cv_ridge, newx=X_test, s=cv_ridge$lambda.min))
} else if (grepl("Lasso", best_reg_name)) {
as.vector(predict(cv_lasso, newx=X_test, s=cv_lasso$lambda.min))
} else if (grepl("Elastic", best_reg_name)) {
as.vector(predict(cv_enet, newx=X_test, s=cv_enet$lambda.min))
} else if (grepl("Stepwise", best_reg_name)) {
predict(ols_step, newdata=test_df)
} else {
predict(ols_full, newdata=test_df)
}
pred_df <- data.frame(actual = y_test, predicted = best_preds)
ggplot(pred_df, aes(x = actual, y = predicted)) +
geom_point(alpha = 0.4, colour = "#2c7bb6") +
geom_abline(colour = "red", linewidth = 1) +
labs(title    = paste("Actual vs Predicted —", best_reg_name),
subtitle = paste("RMSE =", min(reg_comparison$RMSE),
"| R² =", reg_comparison$R2[which.min(reg_comparison$RMSE)]),
x = "Actual", y = "Predicted")
# ============================================================
#  SECTION 9 — BINARY CLASSIFICATION WITH LOGISTIC REGRESSION
#
#  Model:  log(p / (1-p)) = β₀ + β₁X₁ + … + βₚXₚ
#  The left side is the LOG-ODDS (logit link function).
#
#  WHY NOT OLS for 0/1 outcome?
#    • OLS predictions can exceed [0,1] — not valid probabilities
#    • Error distribution is Bernoulli, NOT Normal
#    • OLS violates homoskedasticity by design with binary Y
#    • Logistic uses Maximum Likelihood Estimation (MLE)
#
#  Interpretation:
#    βⱼ           → log-odds change per unit Xⱼ (hard to interpret)
#    exp(βⱼ)      → ODDS RATIO: how much the odds multiply per unit Xⱼ
#    exp(βⱼ) > 1  → positive effect on probability of outcome=1
#    exp(βⱼ) < 1  → negative effect
# ============================================================
if (!is.null(target_cls)) {
# Build classification formula (same scaled numeric predictors as regression)
cls_formula <- as.formula(
paste(target_cls, "~", paste(reg_predictors, collapse=" + "))
)
# --- 9.1  Fit standard logistic regression ---
logit_full <- glm(cls_formula, data = train_df, family = binomial(link = "logit"))
cat("\n===== LOGISTIC REGRESSION SUMMARY =====\n")
print(summary(logit_full))
# tidy with exponentiate = TRUE → shows odds ratios directly
tidy_logit <- tidy(logit_full, exponentiate = TRUE, conf.int = TRUE) %>%
rename(odds_ratio = estimate) %>%
mutate(significance = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
TRUE            ~ ""
))
print(kable(tidy_logit,
caption = "Logistic Regression — Odds Ratios + 95% CI",
digits  = 4) %>%
kable_styling(bootstrap_options = c("striped","hover","condensed")))
# --- 9.2  Pseudo-R² (McFadden) ---
# No direct R² in logistic regression; McFadden's ρ² = 1 - (LL_full / LL_null)
# McFadden > 0.2 is generally considered a good fit
null_logit  <- glm(as.formula(paste(target_cls, "~ 1")),
data = train_df, family = binomial)
mcfadden_r2 <- as.numeric(1 - logLik(logit_full) / logLik(null_logit))
cat(sprintf("\nMcFadden's Pseudo-R²: %.4f  (> 0.2 considered good)\n", mcfadden_r2))
# --- 9.3  Hosmer-Lemeshow goodness-of-fit test ---
# Tests whether observed event rates match predicted probabilities across deciles.
# H₀: model fits well  |  p > 0.05 desired (we do NOT want to reject)
prob_train   <- fitted(logit_full)
y_bin_train  <- as.numeric(train_df[[target_cls]]) - 1
hl_test      <- hoslem.test(y_bin_train, prob_train, g = 10)
cat("\nHosmer-Lemeshow test (H₀: model fits well):\n")
print(hl_test)
cat(ifelse(hl_test$p.value > 0.05,
"✔ Good fit — H₀ not rejected\n",
"⚠ Poor calibration — consider adding predictors or interactions\n"))
# --- 9.4  Regularised Logistic — Lasso (automatic variable selection) ---
X_cls_train <- model.matrix(cls_formula, data = train_df)[, -1]
y_cls_train <- as.numeric(train_df[[target_cls]]) - 1
X_cls_test  <- model.matrix(cls_formula, data = test_df)[, -1]
y_cls_test  <- as.numeric(test_df[[target_cls]]) - 1
cv_lasso_cls <- cv.glmnet(X_cls_train, y_cls_train,
alpha = 1, family = "binomial",
nfolds = 10, type.measure = "auc")
cat("\nLasso Logistic optimal λ:", cv_lasso_cls$lambda.min,
"| CV-AUC:", round(max(cv_lasso_cls$cvm), 4), "\n")
# --- 9.5  Linear Discriminant Analysis (LDA) ---
# LDA assumes Gaussian class-conditional densities + equal covariance matrices.
# Equivalent to logistic regression asymptotically when assumptions hold.
# More stable than logistic with small sample sizes.
lda_fit <- lda(cls_formula, data = train_df)
cat("\nLDA prior probabilities:\n")
print(lda_fit$prior)
# --- 9.6  Coefficient (log-odds) plot ---
tidy_log_plot <- tidy(logit_full, exponentiate = FALSE, conf.int = TRUE)
ggplot(tidy_log_plot[-1, ], aes(x = reorder(term, estimate),
y = estimate,
ymin = conf.low, ymax = conf.high)) +
geom_pointrange(colour = "#1a9641") +
geom_hline(yintercept = 0, colour = "red", linetype = "dashed") +
coord_flip() +
labs(title    = "Logistic Regression — Log-Odds Coefficients with 95% CI",
subtitle = "Coefficients crossing zero are not significant at α = 0.05",
x = NULL, y = "Log-Odds Estimate")
} else {
cat("No binary target identified. Classification section skipped.\n")
}
# ============================================================
#  SECTION 10 — EVALUATING CLASSIFICATION MODELS
#
#  Metrics:
#    Accuracy    — (TP+TN)/N  [misleading when classes are imbalanced]
#    Precision   — TP/(TP+FP) [of predicted positives, how many correct?]
#    Recall      — TP/(TP+FN) [of actual positives, how many caught?]
#    F1-Score    — 2*(Prec*Rec)/(Prec+Rec)  [harmonic mean; balanced metric]
#    Specificity — TN/(TN+FP) [true negative rate]
#    AUC-ROC     — area under ROC; 0.5=random, 1=perfect
#    Kappa       — agreement beyond chance; 0=no agreement, 1=perfect
#
#  THRESHOLD: Default = 0.5, but optimal threshold by Youden's J
#             maximises Sensitivity + Specificity - 1
# ============================================================
if (!is.null(target_cls)) {
# Generate predicted probabilities on test set
cls_probs_logit <- predict(logit_full, newdata = test_df, type = "response")
cls_probs_lasso <- as.vector(predict(cv_lasso_cls, newx = X_cls_test,
s = cv_lasso_cls$lambda.min, type = "response"))
cls_probs_lda   <- predict(lda_fit, newdata = test_df)$posterior[, 2]
# Helper: compute full metrics at any probability threshold
eval_cls <- function(probs, y_true, threshold = 0.5, model_name = "Model") {
preds <- factor(ifelse(probs >= threshold, 1, 0), levels = c(0,1))
y_fac <- factor(y_true, levels = c(0,1))
cm    <- confusionMatrix(preds, y_fac, positive = "1")
data.frame(
Model       = model_name,
Threshold   = threshold,
Accuracy    = round(cm$overall["Accuracy"],     4),
Precision   = round(cm$byClass["Precision"],    4),
Recall      = round(cm$byClass["Recall"],       4),
F1          = round(cm$byClass["F1"],           4),
Specificity = round(cm$byClass["Specificity"],  4),
Kappa       = round(cm$overall["Kappa"],        4)
)
}
# Find optimal threshold via Youden's J (maximises Sens + Spec)
roc_logit  <- roc(y_cls_test, cls_probs_logit, quiet = TRUE)
youden_idx <- which.max(roc_logit$sensitivities + roc_logit$specificities - 1)
opt_thresh <- roc_logit$thresholds[youden_idx]
cat(sprintf("\nOptimal threshold (Youden's J): %.3f\n", opt_thresh))
# Evaluate all models + logistic at both thresholds
cls_metrics_df <- bind_rows(
eval_cls(cls_probs_logit, y_cls_test, 0.5,       "Logistic (0.5)"),
eval_cls(cls_probs_logit, y_cls_test, opt_thresh, paste0("Logistic (opt=", round(opt_thresh,2),")")),
eval_cls(cls_probs_lasso, y_cls_test, 0.5,       "Lasso Logistic"),
eval_cls(cls_probs_lda,   y_cls_test, 0.5,       "LDA")
)
cat("\n===== CLASSIFICATION MODEL COMPARISON =====\n")
print(kable(cls_metrics_df,
caption = "Test-Set Classification Metrics") %>%
kable_styling(bootstrap_options = c("striped","hover","condensed")))
# --- ROC Curves — all models overlaid ---
roc_lasso <- roc(y_cls_test, cls_probs_lasso, quiet = TRUE)
roc_lda   <- roc(y_cls_test, cls_probs_lda,   quiet = TRUE)
roc_df <- bind_rows(
data.frame(model = paste0("Logistic AUC=", round(auc(roc_logit), 3)),
fpr = 1-roc_logit$specificities, tpr = roc_logit$sensitivities),
data.frame(model = paste0("Lasso AUC=",    round(auc(roc_lasso), 3)),
fpr = 1-roc_lasso$specificities, tpr = roc_lasso$sensitivities),
data.frame(model = paste0("LDA AUC=",      round(auc(roc_lda),   3)),
fpr = 1-roc_lda$specificities,   tpr = roc_lda$sensitivities)
)
p_roc <- ggplot(roc_df, aes(x = fpr, y = tpr, colour = model)) +
geom_line(linewidth = 1.1) +
geom_abline(linetype = "dashed", colour = "grey50") +
annotate("point",
x = 1 - roc_logit$specificities[youden_idx],
y = roc_logit$sensitivities[youden_idx],
colour = "black", size = 3, shape = 17) +
labs(title    = "ROC Curves — All Classification Models",
subtitle = "▲ = Optimal logistic threshold by Youden's J",
x = "False Positive Rate (1-Specificity)",
y = "True Positive Rate (Sensitivity)",
colour = "Model") +
scale_colour_manual(values = c("#d7191c","#2c7bb6","#1a9641"))
print(p_roc)
# Confusion matrix heatmap for best model (highest F1)
best_cls_model <- cls_metrics_df$Model[which.max(cls_metrics_df$F1)]
cat("\nBest classification model (by F1):", best_cls_model, "\n")
best_probs <- if (grepl("Lasso", best_cls_model)) cls_probs_lasso
else if (grepl("LDA", best_cls_model)) cls_probs_lda
else cls_probs_logit
best_thr   <- if (grepl(as.character(round(opt_thresh, 2)), best_cls_model)) opt_thresh else 0.5
best_preds_cls <- factor(ifelse(best_probs >= best_thr, 1, 0), levels = c(0,1))
cm_best <- confusionMatrix(best_preds_cls, factor(y_cls_test, levels=c(0,1)), positive="1")
print(cm_best)
cm_tbl <- as.data.frame(cm_best$table)
ggplot(cm_tbl, aes(x = Reference, y = Prediction, fill = Freq)) +
geom_tile(colour = "white") +
geom_text(aes(label = Freq), size = 6, fontface = "bold") +
scale_fill_gradient(low = "#f7f7f7", high = "#2c7bb6") +
labs(title = paste("Confusion Matrix —", best_cls_model), fill = "Count")
} else {
cat("No binary target identified. Section 10 skipped.\n")
}
# ============================================================
#  SECTION 11 — ADVANCED LINEAR MODEL TOPICS
#
#  A) Interaction terms       — effect of X₁ depends on X₂
#  B) Polynomial regression   — curvature while staying linear in parameters
#  C) Robust regression (rlm) — down-weights outliers (M-estimators)
#  D) k-Fold CV via caret     — apples-to-apples model comparison
#  E) Partial F-test          — compare nested models formally
# ============================================================
# --- 11.A  Interaction Terms ---
# β₁₂ X₁X₂: the slope of Y on X₁ changes with the level of X₂
# Include interactions when domain knowledge suggests synergy between predictors.
if (length(reg_predictors) >= 2) {
int_vars    <- reg_predictors[1:2]
int_formula <- as.formula(paste(
target_reg_model, "~",
paste(reg_predictors, collapse=" + "), "+",
paste(int_vars, collapse=":")
))
ols_interaction <- lm(int_formula, data = train_df)
cat("Interaction term:", paste(int_vars, collapse=" × "), "\n")
# Partial F-test: is the interaction term a significant improvement?
lrt_int <- anova(ols_full, ols_interaction, test = "F")
cat("\nPartial F-test — Full vs Interaction model:\n")
print(lrt_int)
cat(ifelse(lrt_int$`Pr(>F)`[2] < 0.05,
"✔ Interaction term is significant — include in final model.\n",
"✗ Interaction term is NOT significant — drop it.\n"))
}
# --- 11.B  Polynomial Regression ---
# poly(X, 2, raw=FALSE) adds orthogonal polynomial terms — reduces collinearity
# between X and X² compared to raw=TRUE.
poly_var     <- reg_predictors[1]
poly_formula <- as.formula(paste(
target_reg_model, "~ poly(", poly_var, ", 2, raw=FALSE) +",
paste(setdiff(reg_predictors, poly_var), collapse=" + ")
))
ols_poly <- lm(poly_formula, data = train_df)
cat(sprintf("\nPolynomial model AIC: %.2f | Full OLS AIC: %.2f\n",
AIC(ols_poly), AIC(ols_full)))
cat(sprintf("Polynomial Adj-R²: %.4f | Full OLS Adj-R²: %.4f\n",
summary(ols_poly)$adj.r.squared, summary(ols_full)$adj.r.squared))
# --- 11.C  Robust Regression (M-estimators via MASS::rlm) ---
# When outliers or heavy-tailed errors inflate OLS residuals, rlm()
# uses Iteratively Reweighted Least Squares (IRWLS) to down-weight
# extreme observations.
# method = "MM": high breakdown point (50%) AND high efficiency (~95% of OLS)
ols_robust <- rlm(ols_formula, data = train_df, method = "MM")
cat("\n--- Robust Regression (MM-estimator) Summary ---\n")
print(summary(ols_robust))
# Where do OLS and robust coefficients diverge most?
coef_compare <- data.frame(
term   = names(coef(ols_full)),
OLS    = round(coef(ols_full),    4),
Robust = round(coef(ols_robust),  4),
diff   = round(coef(ols_full) - coef(ols_robust), 4)
) %>% arrange(desc(abs(diff)))
print(kable(head(coef_compare, 10),
caption = "Top 10 OLS vs Robust Coefficient Differences",
digits = 4))
# Large differences signal that those coefficients are heavily influenced
# by outliers in the training data.
# --- 11.D  10-Fold CV with caret (unified interface) ---
# caret::train() wraps any model family behind a consistent API,
# enabling truly comparable cross-validation across OLS / Ridge / Lasso.
ctrl <- trainControl(method="cv", number=10, verboseIter=FALSE, returnData=FALSE)
caret_ols   <- train(ols_formula, data=train_df, method="lm",     trControl=ctrl)
caret_ridge <- train(ols_formula, data=train_df, method="glmnet", trControl=ctrl,
tuneGrid = expand.grid(alpha=0, lambda=cv_ridge$lambda.min))
caret_lasso <- train(ols_formula, data=train_df, method="glmnet", trControl=ctrl,
tuneGrid = expand.grid(alpha=1, lambda=cv_lasso$lambda.min))
cv_results <- resamples(list(OLS=caret_ols, Ridge=caret_ridge, Lasso=caret_lasso))
cat("\n===== 10-FOLD CV MODEL COMPARISON =====\n")
print(summary(cv_results))
dotplot(cv_results, main = "10-Fold CV — RMSE and R² Distribution Across Models")
# ============================================================
#  SECTION 12 — CONCEPTS EVERY LINEAR MODELS STUDENT MUST KNOW
#
#  Topics:
#    A) Standardised (beta) coefficients — effect size comparison
#    B) Partial R² — unique contribution of each predictor
#    C) ANOVA as a Linear Model — GLM unification principle
#    D) Leverage, Influence, and Outlier diagnosis (full pipeline)
#    E) Power analysis — what sample size do we need?
#    F) Model Complexity: Bias-Variance tradeoff visualised
#    G) Coefficient of determination decomposition (SST = SSR + SSE)
#    H) Confidence vs Prediction intervals — often confused
# ============================================================
# --- 12.A  Standardised (Beta) Coefficients ---
# When predictors are on different scales, raw OLS coefficients are NOT
# directly comparable. Standardised betas (β*) are computed by scaling
# both Y and X to mean=0, sd=1 BEFORE fitting.
# β*ⱼ = "a 1-SD increase in Xⱼ is associated with a β*ⱼ SD change in Y"
ols_std <- lm(ols_formula, data = train_df)   # already scaled in preproc
std_betas <- tidy(ols_std) %>%
filter(term != "(Intercept)") %>%
arrange(desc(abs(estimate)))
cat("--- Standardised Beta Coefficients (already scaled predictors) ---\n")
print(kable(std_betas, caption = "Standardised β — Effect Size Ranking", digits=4))
ggplot(std_betas, aes(x = reorder(term, abs(estimate)),
y = estimate, fill = estimate > 0)) +
geom_col() +
coord_flip() +
scale_fill_manual(values = c("#d7191c","#2c7bb6"),
labels = c("Negative","Positive")) +
labs(title = "Standardised Beta Coefficients — Effect Size",
subtitle = "Larger absolute value = stronger unique contribution",
x = NULL, y = "Standardised β", fill = "Direction")
# --- 12.B  Variance decomposition: SST = SSR + SSE ---
# Total variance in Y is partitioned into:
#   SSR (Regression SS) — variation EXPLAINED by the model
#   SSE (Error SS)      — variation LEFT in residuals
#   R² = SSR / SST
aov_table <- anova(ols_full)
cat("\n--- ANOVA Table for OLS model ---\n")
print(aov_table)
# Each row shows how much variance each predictor explains incrementally
# (sequential / Type I SS).  car::Anova() gives Type II or III SS.
cat("\n--- Type II ANOVA (car::Anova — adjusted for other predictors) ---\n")
tryCatch(print(car::Anova(ols_full, type = "II")),
error = function(e) cat("Type II ANOVA skipped:", conditionMessage(e), "\n"))
# --- 12.C  ANOVA as a Special Case of Linear Model ---
# One-way ANOVA ≡ lm(Y ~ factor(group)) with a single categorical predictor.
# The F-statistic in ANOVA output == the model F-test in lm() summary.
# This unification means ALL parametric tests are special cases of the GLM.
if (length(cat_vars) > 0) {
cat_var_demo <- cat_vars[1]
cat(sprintf("\n--- ANOVA as LM: lm(%s ~ %s) ---\n", target_reg_model, cat_var_demo))
anova_as_lm <- lm(as.formula(paste(target_reg_model, "~", cat_var_demo)),
data = train_df)
print(summary(anova_as_lm))  # same as oneway.test() / aov()
}
# --- 12.D  Confidence Intervals vs Prediction Intervals ---
# CONFIDENCE interval: uncertainty about the *mean* response for given X
#   → narrower; reflects estimation uncertainty in β
# PREDICTION interval: uncertainty about a *new individual* observation
#   → always wider; adds σ² (residual variance) on top of CI
# Always show prediction intervals when forecasting individual outcomes.
# Take first 5 rows of test data as example
example_rows <- test_df[1:min(5, nrow(test_df)), reg_predictors, drop=FALSE]
ci_fit <- predict(ols_full,
newdata   = example_rows,
interval  = "confidence",
level     = 0.95)
pi_fit <- predict(ols_full,
newdata   = example_rows,
interval  = "prediction",
level     = 0.95)
interval_compare <- data.frame(
obs          = 1:nrow(ci_fit),
fitted       = round(ci_fit[,"fit"],   4),
CI_lower     = round(ci_fit[,"lwr"],   4),
CI_upper     = round(ci_fit[,"upr"],   4),
PI_lower     = round(pi_fit[,"lwr"],   4),
PI_upper     = round(pi_fit[,"upr"],   4),
CI_width     = round(ci_fit[,"upr"] - ci_fit[,"lwr"], 4),
PI_width     = round(pi_fit[,"upr"] - pi_fit[,"lwr"], 4)
)
print(kable(interval_compare,
caption = "Confidence vs Prediction Intervals (first 5 test obs)") %>%
kable_styling(bootstrap_options = c("striped","hover")))
cat("Note: PI is always wider than CI because it incorporates individual randomness.\n")
# --- 12.E  Partial R² — Unique Contribution of Each Predictor ---
# Partial R² = (R²_full - R²_minus_Xⱼ) / (1 - R²_minus_Xⱼ)
# Tells you how much variance predictor Xⱼ explains beyond ALL other predictors.
r2_full <- summary(ols_full)$r.squared
partial_r2 <- sapply(reg_predictors, function(var) {
formula_reduced <- as.formula(paste(
target_reg_model, "~",
paste(setdiff(reg_predictors, var), collapse=" + ")
))
r2_reduced <- tryCatch(
summary(lm(formula_reduced, data=train_df))$r.squared,
error = function(e) r2_full
)
round((r2_full - r2_reduced) / (1 - r2_reduced), 4)
})
partial_r2_df <- data.frame(
predictor  = reg_predictors,
partial_r2 = partial_r2
) %>% arrange(desc(partial_r2))
cat("\n--- Partial R² — Unique Variance Explained per Predictor ---\n")
print(kable(partial_r2_df,
caption = "Partial R² (unique contribution beyond all other predictors)") %>%
kable_styling(bootstrap_options = c("striped","hover","condensed")))
# --- 12.F  Bias-Variance Tradeoff Conceptual Display ---
# As model complexity increases:
#   Training error decreases monotonically (overfitting)
#   Test error has a U-shape (optimal complexity in the middle)
# This is WHY we use regularisation (Ridge/Lasso) and CV.
complexity_demo <- data.frame(
complexity = 1:10,
train_err  = 1 / (1:10) + 0.05,
test_err   = 1 / (1:10) + 0.05 + 0.02 * (1:10 - 4)^2 / 16
)
ggplot(complexity_demo, aes(x = complexity)) +
geom_line(aes(y = train_err, colour = "Training Error"), linewidth=1.3) +
geom_line(aes(y = test_err,  colour = "Test Error"),     linewidth=1.3, linetype="dashed") +
geom_vline(xintercept = 4, linetype="dotted", colour="grey30") +
annotate("text", x=4.2, y=max(complexity_demo$test_err)*0.9,
label="Optimal Complexity", hjust=0, size=3.5) +
scale_colour_manual(values = c("Training Error"="#2c7bb6","Test Error"="#d7191c")) +
labs(title   = "Bias-Variance Tradeoff",
subtitle = "Regularisation finds the optimal complexity region",
x = "Model Complexity (degrees of freedom)",
y = "Prediction Error", colour = NULL)
# ============================================================
#  SECTION 13 — SYNTHESIS, DECISION FRAMEWORK & SESSION INFO
# ============================================================
cat("
╔══════════════════════════════════════════════════════════════╗
║       LINEAR MODELS STUDY — CONSOLIDATED FINDINGS           ║
║       Valerie Jerono | 222331 | Linear Models — Dr. Evans   ║
╚══════════════════════════════════════════════════════════════╝
REGRESSION RESULTS
──────────────────
")
print(kable(reg_comparison %>% arrange(RMSE),
caption = "Regression Models — Test Set Performance") %>%
kable_styling(bootstrap_options = c("striped","hover")))
if (!is.null(target_cls)) {
cat("\nCLASSIFICATION RESULTS\n──────────────────────\n")
print(kable(cls_metrics_df %>% arrange(desc(F1)),
caption = "Classification Models — Test Set Performance") %>%
kable_styling(bootstrap_options = c("striped","hover")))
}
cat("
ASSUMPTION STATUS SUMMARY
──────────────────────────
")
print(kable(assumption_summary) %>%
kable_styling(bootstrap_options = c("striped","hover")))
cat("
MODEL SELECTION DECISION FRAMEWORK
────────────────────────────────────
1.  START with OLS full model as interpretable baseline.
2.  RUN assumption battery (Sections 5–6) BEFORE trusting any inference.
3.  TRANSFORM target/predictors if normality or linearity violated.
4.  USE HC3-robust SEs if heteroskedasticity persists after transformation.
5.  USE Ridge when multicollinearity is severe (VIF > 5).
6.  USE Lasso when many predictors are expected to be irrelevant (sparse signal).
7.  USE Elastic Net when groups of correlated predictors exist.
8.  USE Robust regression (rlm) when Cook's D / leverage flags influential points.
9.  ADD interaction or polynomial terms when RESET test or residual plots signal
non-linearity; test with partial F-test / AIC comparison.
10. VALIDATE every model on a held-out test set — never rely solely on CV.
11. INTERPRET coefficients causally ONLY in experimental (RCT) settings.
Observational data → associations, not causal claims.
12. REPORT both in-sample fit (Adj-R², AIC) AND generalisation (test RMSE/AUC).
KEY ASSUMPTIONS REMINDER (LINE)
────────────────────────────────
L — Linearity       checked with RESET test + Residuals vs Fitted plot
I — Independence    checked with Durbin-Watson; critical for time-series
N — Normality       checked with S-W / A-D + Q-Q plot + skewness/kurtosis
E — Equal variance  checked with Breusch-Pagan + NCV test
FST WORKFLOW TAKEAWAYS
───────────────────────
• write_fst() / read_fst() are drop-in replacements for read.csv for large data.
• Partial column reads (columns=) minimise RAM usage in wide datasets.
• FST files are lossless and significantly smaller + faster than CSV.
ADAPTABILITY NOTE
──────────────────
This notebook auto-detects target variables and adapts to ANY dataset.
To use with a different dataset: change the read.csv() path in Section 1.
Target detection heuristics in Section 2 will re-run accordingly.
SESSION INFO
────────────
")
print(sessionInfo())
reticulate::repl_python()
knitr::opts_chunk$set(echo = TRUE)
reticulate::repl_python()
